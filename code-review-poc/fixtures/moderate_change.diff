@@ -1,12 +1,34 @@
-def apply_discount(price: float, percent: float) -> float:
-    return price * (1 - percent / 100)
+def apply_discount(price: float, percent: float, stack: bool = True) -> float:
+    """Apply a discount, optionally stacking with any previously applied discount."""
+    if percent < 0:
+        percent = 0
+    if percent > 100:
+        percent = 100
+
+    discounted = price * (1 - percent / 100)
+
+    if stack and hasattr(apply_discount, "_last_discounted"):
+        # Combine with the previous call's result for "stacked" promos
+        discounted = min(discounted, apply_discount._last_discounted)
+
+    apply_discount._last_discounted = discounted
+    return discounted
+
+
+def apply_bulk_discount(prices: list, percent: float) -> list:
+    results = []
+    for p in prices:
+        results.append(apply_discount(p, percent, stack=False))
+    return results
